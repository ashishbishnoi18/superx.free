# Copy to .env and fill in. Never commit the result.

# --- Required ---------------------------------------------------------------

# Postgres. Only used by docker-compose to provision the database.
POSTGRES_USER=superx
POSTGRES_PASSWORD=change-me
POSTGRES_DB=superx

# mix phx.gen.secret
SECRET_KEY_BASE=

# mix superx.gen.vault_key
# Encrypts stored X tokens. Losing it forces every user to reconnect.
SUPERX_VAULT_KEY=

# The hostname the app is served on, used to build absolute URLs.
PHX_HOST=localhost

# Interface the container publishes on. Leave as loopback if a reverse
# proxy terminates TLS in front; set 0.0.0.0 to expose directly.
BIND_ADDR=127.0.0.1

# --- X OAuth (required for sign-in and publishing) --------------------------
#
# Create an app at https://developer.x.com, enable OAuth 2.0 with PKCE,
# set the type to "Web App", and add the callback URL below.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:4000/auth/x/callback

# Off by default. Before enabling, change the X app permission tier to
# "Read and write and Direct message". Every connected account must then
# re-authorise because the OAuth request adds dm.read and dm.write.
SUPERX_ENABLE_DMS=false

# --- LLM (required for voice profiles and drafting) -------------------------
ANTHROPIC_API_KEY=

# Optional. Enables semantic corpus retrieval; without it search falls
# back to Postgres full text, which still works but matches less well.
VOYAGE_API_KEY=

# --- Billing (optional) ------------------------------------------------------
#
# Leave unset on a private instance: everyone keeps free-tier limits and
# the upgrade page explains that billing isn't configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_ADVANCED_MONTH=
STRIPE_PRICE_ADVANCED_YEAR=
STRIPE_PRICE_ULTRA_MONTH=
STRIPE_PRICE_ULTRA_YEAR=
STRIPE_SEAT_PRICE_PRO_MONTH=
STRIPE_SEAT_PRICE_PRO_YEAR=
STRIPE_SEAT_PRICE_ADVANCED_MONTH=
STRIPE_SEAT_PRICE_ADVANCED_YEAR=
STRIPE_SEAT_PRICE_ULTRA_MONTH=
STRIPE_SEAT_PRICE_ULTRA_YEAR=

# --- Scraper (optional) ------------------------------------------------------
#
# Populates the Inspiration corpus. Read scraper/README.md before
# enabling — this is the part that isn't covered by X's API terms.
# Unset means the corpus stays empty and everything else works.
X_WEB_BEARER=
X_SEARCH_PATH=
X_SEARCH_FEATURES={}
X_MIN_REQUEST_INTERVAL=2000

# Route scraper egress through your own infrastructure.
HTTPS_PROXY=

# Tier for users without a paid subscription. Leave as `free` for a
# multi-tenant deployment; set to `ultra` on a private instance so you
# are not throttled by your own quotas.
SUPERX_DEFAULT_TIER=free

# twitterapi.io — the read side. Bills per record; see README.
TWITTERAPI_IO_KEY=
TWITTERAPI_IO_MIN_INTERVAL_MS=6000

# The nightly corpus bill. Defaults buy ~800 posts a night, roughly
# 12,000 credits. Raise to build a library faster, lower to stretch a
# balance; on the free tier speed binds first and raising these only
# lengthens the queue.
SUPERX_CORPUS_TOPICS_PER_RUN=20
SUPERX_CORPUS_POSTS_PER_TOPIC=40

# LLM provider: anthropic (default) or deepseek. Both speak the same
# wire format; see README.
SUPERX_LLM_PROVIDER=anthropic
DEEPSEEK_API_KEY=
# Optional per-model overrides.
SUPERX_WRITER_MODEL=
SUPERX_UTILITY_MODEL=
