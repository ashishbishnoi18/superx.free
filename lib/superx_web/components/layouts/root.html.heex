<!DOCTYPE html>
<html lang="en" class="h-full" data-theme={root_theme(assigns[:current_user])}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="description" content={page_description(assigns)} />
    <meta
      name="theme-color"
      content="oklch(0.984 0.0035 83)"
      media="(prefers-color-scheme: light)"
    />
    <meta name="theme-color" content="oklch(0.185 0.004 70)" media="(prefers-color-scheme: dark)" />

    <link rel="canonical" href={canonical_url(assigns)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SuperX" />
    <meta property="og:title" content={meta_title(assigns)} />
    <meta property="og:description" content={page_description(assigns)} />
    <meta property="og:url" content={canonical_url(assigns)} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={meta_title(assigns)} />
    <meta name="twitter:description" content={page_description(assigns)} />

    <.live_title default={default_page_title()} suffix=" · SuperX" phx-no-format>
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" type="image/svg+xml" href={~p"/images/logo.svg"} />
    <link rel="icon" type="image/x-icon" href={~p"/favicon.ico"} sizes="48x48" />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="h-full">
    {@inner_content}
  </body>
</html>
