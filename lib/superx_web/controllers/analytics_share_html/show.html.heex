<div class="min-h-full">
  <header class="measure flex items-center justify-between px-6 py-5">
    <Layouts.logo class="text-[15px]" />
    <Layouts.theme_toggle />
  </header>

  <main id="shared-analytics" class="measure px-6 pb-20 pt-12 sm:pt-20">
    <p class="nb-eyebrow mb-5">Shared analytics</p>
    <h1 class="text-[clamp(2rem,5vw,3rem)] font-semibold leading-[1.08] tracking-[-0.035em]">
      {@public.account.display_name || "@#{@public.account.handle}"}
    </h1>
    <p class="mt-3 text-muted-foreground">
      @{@public.account.handle} · {Calendar.strftime(@public.from_date, "%-d %b %Y")}–{Calendar.strftime(
        @public.to_date,
        "%-d %b %Y"
      )}
    </p>

    <div class="mt-10 grid grid-cols-2 gap-px border-y border-border bg-border lg:grid-cols-4">
      <.metric
        label="Followers"
        value={@public.summary.followers}
        change={@public.summary.followers_change}
      />
      <.metric label="Posts" value={@public.summary.posts} />
      <.metric label="Impressions" value={@public.summary.impressions} />
      <.metric label="Engagements" value={@public.summary.engagements} />
    </div>

    <section :if={@public.summary.series != []} class="mt-10 border-t border-border pt-6">
      <div class="flex items-baseline justify-between">
        <h2 class="text-[15px] font-semibold">Followers</h2>
        <span class="nb-mono text-[11px] text-faint">
          {format_count(List.first(@public.summary.series).followers)} → {format_count(
            @public.summary.followers
          )}
        </span>
      </div>
      <.sparkline series={@public.summary.series} />
    </section>

    <div :if={@public.summary.series == []} class="border-t border-border py-14 text-center">
      <p class="text-muted-foreground">No snapshots were recorded in this shared window.</p>
    </div>
  </main>
</div>
