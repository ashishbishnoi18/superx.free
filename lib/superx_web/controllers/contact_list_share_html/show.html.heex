<div class="min-h-full">
  <header class="measure flex items-center justify-between px-6 py-5">
    <Layouts.logo class="text-[15px]" />
    <Layouts.theme_toggle />
  </header>

  <main id="shared-contact-list" class="measure px-6 pb-20 pt-12 sm:pt-20">
    <p class="nb-eyebrow mb-5">Shared circle</p>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-[clamp(2rem,5vw,3rem)] font-semibold leading-[1.08] tracking-[-0.035em]">
          {@public.list.name}
        </h1>
        <p class="mt-3 text-muted-foreground">
          Shared by {@public.account.display_name || "@#{@public.account.handle}"}
          <span class="nb-mono ml-1 text-[11px] text-faint">{@public.count} contacts</span>
        </p>
      </div>
      <span :if={@public.list.derived?} class="nb-eyebrow">Updates automatically</span>
    </div>

    <div
      :if={@public.contacts == []}
      id="shared-contacts-empty"
      class="border-t border-border py-16 text-center mt-10"
    >
      <p class="text-muted-foreground">There are no contacts in this circle yet.</p>
    </div>

    <div id="shared-contacts" class="mt-10 flex flex-col">
      <article
        :for={contact <- @public.contacts}
        class="border-b border-border py-5 first:border-t"
      >
        <p class="flex flex-wrap items-baseline gap-2">
          <a
            href={"https://x.com/#{contact.handle}"}
            target="_blank"
            rel="noopener"
            class="hover-ember font-medium"
          >
            {contact.display_name || contact.handle}
          </a>
          <span class="text-faint">@{contact.handle}</span>
          <span :if={contact.verified} class="nb-mono text-[10px] text-primary">verified</span>
          <span class="nb-mono text-[11px] text-faint">
            {compact(contact.followers_count)} followers
          </span>
        </p>
        <p :if={contact.bio} class="mt-1.5 max-w-[68ch] text-[13px] text-muted-foreground">
          {contact.bio}
        </p>
      </article>
    </div>

    <nav
      :if={@public.pages > 1}
      id="shared-contact-pages"
      class="mt-8 flex items-center justify-between border-t border-border pt-4 text-xs"
      aria-label="Contact pages"
    >
      <.link
        :if={@public.page > 1}
        href={~p"/circle/#{@token}?page=#{@public.page - 1}"}
        class="act"
      >
        Previous
      </.link>
      <span :if={@public.page == 1}></span>
      <span class="nb-mono text-[11px] text-faint">{@public.page} / {@public.pages}</span>
      <.link
        :if={@public.page < @public.pages}
        href={~p"/circle/#{@token}?page=#{@public.page + 1}"}
        class="act"
      >
        Next
      </.link>
      <span :if={@public.page >= @public.pages}></span>
    </nav>
  </main>
</div>
