<!DOCTYPE html>
<html lang="en" class="h-full" data-theme="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Something went wrong · SuperX</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={~p"/images/logo.svg"} />
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
  </head>
  <body class="h-full">
    <main class="grid h-full place-items-center px-6">
      <div class="flex max-w-sm flex-col items-center text-center">
        <Layouts.logo_mark class="size-8" />
        <p class="nb-eyebrow mt-10">500</p>
        <h1 class="nb-display mt-3 text-[2rem] font-semibold leading-tight tracking-[-0.03em]">
          Something went wrong
        </h1>
        <p class="mt-3 text-muted-foreground">
          The server hit an unexpected error. Try again in a moment.
        </p>
        <.link href={~p"/"} class="btn mt-8">Back to SuperX</.link>
      </div>
    </main>
  </body>
</html>
