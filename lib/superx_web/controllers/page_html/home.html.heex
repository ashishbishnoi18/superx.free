<div class="min-h-full">
  <header class="measure flex items-center justify-between px-6 py-5">
    <Layouts.logo class="text-[15px]" />
    <div class="flex items-center gap-6 text-xs">
      <Layouts.theme_toggle />
      <.link :if={@x_configured} href={~p"/auth/x"} class="act-key">
        Sign in with 𝕏
      </.link>
    </div>
  </header>

  <main class="measure px-6">
    <section class="py-20 sm:py-28">
      <p class="nb-eyebrow mb-6">Self-hosted · your data stays yours</p>

      <h1 class="max-w-[18ch] text-[clamp(2.25rem,6vw,3.75rem)] font-semibold leading-[1.05] tracking-[-0.035em]">
        Grow on 𝕏 without living on 𝕏
      </h1>

      <p class="mt-6 max-w-[58ch] text-[17px] leading-[1.6] text-muted-foreground">
        SuperX learns how you write, finds the posts worth learning from, and keeps
        your queue full — so posting consistently stops depending on your mood.
      </p>

      <div class="mt-9">
        <.link :if={@x_configured} href={~p"/auth/x"} class="act-key text-[15px]">
          Sign in with 𝕏 →
        </.link>

        <p :if={!@x_configured} class="max-w-[52ch] text-muted-foreground">
          <span class="nb-mono text-[11px] text-destructive">not configured</span>
          <br /> X sign-in isn't configured yet. Set
          <code class="nb-mono text-[12px] text-foreground">X_CLIENT_ID</code>
          and <code class="nb-mono text-[12px] text-foreground">X_CLIENT_SECRET</code>,
          then restart. The README lists every variable.
        </p>
      </div>
    </section>

    <section class="flex flex-col pb-24">
      <div
        :for={{feature, index} <- Enum.with_index(@features, 1)}
        class="grid grid-cols-1 gap-7 border-t border-border py-7 last:border-b sm:grid-cols-[7.5rem_minmax(0,1fr)]"
      >
        <span class="nb-mono text-[11px] text-faint">
          {String.pad_leading(to_string(index), 2, "0")}
        </span>
        <div>
          <h2 class="text-[15px] font-semibold">{feature.title}</h2>
          <p class="mt-1.5 max-w-[62ch] leading-[1.6] text-muted-foreground">{feature.body}</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-border py-7">
    <div class="measure flex flex-col gap-1 px-6 text-[12px] text-faint sm:flex-row sm:items-center sm:justify-between">
      <p>SuperX — self-hosted 𝕏 growth workstation</p>
      <p>Runs on your own box. No third-party analytics.</p>
    </div>
  </footer>
</div>
